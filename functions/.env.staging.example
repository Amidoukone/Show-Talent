# Staging overrides loaded when deploying with alias or project "staging".
APP_ENV=staging
ENFORCE_APPCHECK=false
STORAGE_BUCKET=your-staging-storage-bucket
OPTIMIZE_TRIGGER_REGION=europe-west1
VIDEO_UPLOADS_ENABLED=true
UPLOAD_CALLABLE_MIN_INSTANCES=0
UPLOAD_CALLABLE_TIMEOUT_SECONDS=120
MAX_VIDEO_UPLOADS_PER_DAY=5
MAX_CONCURRENT_VIDEO_UPLOADS=1
MAX_OPTIMIZE_FILE_SIZE_BYTES=157286400
UNVERIFIED_ACCOUNT_RETENTION_DAYS=3
UNVERIFIED_PURGE_EXCLUDE_MANAGED=true
EMAIL_LINK_CUSTOM_HOST=
VIDEO_SHARE_BASE_URL=https://adfoot-staging.firebaseapp.com
ANDROID_PACKAGE_NAME=org.adfoot.app.staging
ANDROID_APP_DOWNLOAD_URL=/download/android/
# Aligned with .env.production.example after the 2026-10-13 closure, so
# staging does not keep mirroring legacy follow arrays while production has
# stopped -- a divergence in precisely the area that just changed would make
# staging useless for validating it. Measured in adfoot-staging on
# 2026-10-13: 7 accounts carried the arrays, 0 edges between them, and 0
# documents in the following/followers subcollections, so the cleanup deletes
# empty fields here too.
#
# Takes effect at the next SUCCESSFUL staging functions deploy. Those are
# currently blocked: Functions v2 discovery resolves BREVO_SMTP_KEY for the
# whole codebase regardless of --only, and Secret Manager is not enabled on
# adfoot-staging. Measure, do not assume:
#   npm run legacy:residue:check:staging
ENABLE_LEGACY_CV_URL_MIGRATION=false
ENABLE_LEGACY_FOLLOW_FIELD_CLEANUP=true
MIRROR_LEGACY_FOLLOW_ARRAYS=false
