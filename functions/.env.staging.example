# Staging overrides loaded when deploying with alias or project "staging".
APP_ENV=staging
ENFORCE_APPCHECK=false
STORAGE_BUCKET=your-staging-storage-bucket
OPTIMIZE_TRIGGER_REGION=us-central1
VIDEO_UPLOADS_ENABLED=true
MAX_VIDEO_UPLOADS_PER_DAY=5
MAX_CONCURRENT_VIDEO_UPLOADS=1
MAX_OPTIMIZE_FILE_SIZE_BYTES=157286400
UNVERIFIED_ACCOUNT_RETENTION_DAYS=3
UNVERIFIED_PURGE_EXCLUDE_MANAGED=true
EMAIL_LINK_CUSTOM_HOST=
VIDEO_SHARE_BASE_URL=https://adfoot-staging.firebaseapp.com
ANDROID_PACKAGE_NAME=org.adfoot.app.staging
ANDROID_APP_DOWNLOAD_URL=/download/android/
