# Production overrides loaded when deploying with alias or project "production".
APP_ENV=production
ENFORCE_APPCHECK=true
# enforce | soft | off. See functions/src/function_runtime.ts.
# "soft" is the settled production posture, not a temporary window. Play
# Integrity fails on a large share of this app's real device fleet, and
# "enforce" took down every mobile callable at once. Tokens are still read and
# logged; a missing one no longer costs an honest user their upload. Raising
# this to "enforce" is a breaking change to the fleet -- see the guardrail in
# test/app_check_posture_guardrails_test.dart before touching it.
APP_CHECK_MODE=soft
STORAGE_BUCKET=your-production-storage-bucket
OPTIMIZE_TRIGGER_REGION=europe-west1
VIDEO_UPLOADS_ENABLED=true
UPLOAD_CALLABLE_MIN_INSTANCES=1
UPLOAD_CALLABLE_TIMEOUT_SECONDS=120
# Parallelism ceiling for optimizeMp4Video. No idle cost (no minInstances).
OPTIMIZE_MAX_INSTANCES=3
MAX_VIDEO_UPLOADS_PER_DAY=10
MAX_CONCURRENT_VIDEO_UPLOADS=2
# Blast-radius ceilings on the outbound push paths. These carry more weight
# than usual because APP_CHECK_MODE=soft leaves no platform attestation gate
# in front of the callables: one fanout notifies every player in the database.
MAX_FANOUTS_PER_HOUR=10
MAX_DIRECT_PUSHES_PER_MINUTE=30
MAX_OPTIMIZE_FILE_SIZE_BYTES=157286400
UNVERIFIED_ACCOUNT_RETENTION_DAYS=3
UNVERIFIED_PURGE_EXCLUDE_MANAGED=true
EMAIL_LINK_CUSTOM_HOST=
VIDEO_SHARE_BASE_URL=https://adfoot.org
ANDROID_PACKAGE_NAME=org.adfoot.app
ANDROID_APP_DOWNLOAD_URL=/download/android/
