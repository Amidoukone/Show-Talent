{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "test": "node --test ../test/functions/cv-view.test.mjs ../test/functions/public-profile-projection.test.mjs",
    "test:cv-view": "npm run build && node --test ../test/functions/cv-view.test.mjs",
    "test:projection": "npm run build && node --test ../test/functions/public-profile-projection.test.mjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google-cloud/storage": "^8.2.0",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.19.20",
    "@types/nodemailer": "^7.0.12",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "typescript": "^5.9.3"
  },
  "private": true
}
