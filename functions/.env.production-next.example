# Production-next overrides loaded when deploying with alias or project "production-next".
# This lane mirrors the future production Firebase project before final cutover.
APP_ENV=production
ENFORCE_APPCHECK=true
STORAGE_BUCKET=your-production-next-storage-bucket
OPTIMIZE_TRIGGER_REGION=europe-west1
VIDEO_UPLOADS_ENABLED=true
MAX_VIDEO_UPLOADS_PER_DAY=10
MAX_CONCURRENT_VIDEO_UPLOADS=2
MAX_OPTIMIZE_FILE_SIZE_BYTES=125829120
UNVERIFIED_ACCOUNT_RETENTION_DAYS=3
UNVERIFIED_PURGE_EXCLUDE_MANAGED=true
VIDEO_SHARE_BASE_URL=https://adfoot.org
ANDROID_PACKAGE_NAME=org.adfoot.app
ANDROID_APP_DOWNLOAD_URL=/download/android/
