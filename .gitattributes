# Force LF for text/source files regardless of core.autocrlf on the
# checkout machine. Without this, a Windows machine with core.autocrlf=true
# (common default) checks these out as CRLF, which trips ESLint's
# linebreak-style rule (google config, functions/.eslintrc.js) and can block
# `firebase deploy --only functions` at the predeploy lint step.
* text=auto eol=lf

*.dart text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.rules text eol=lf
*.gradle text eol=lf

# Known binaries -- never text-normalize these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.jar binary
*.zip binary
*.aab binary
*.apk binary
*.keystore binary
*.jks binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
