rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // authDisabled is the only remaining hard access stop.
    function hasActiveAccount(uid) {
      return hasUserDoc(uid) &&
        userDoc(uid).data.authDisabled != true;
    }

    function signedInAndActive() {
      return signedIn() && hasActiveAccount(request.auth.uid);
    }

    function userRole() {
      return signedIn() && hasUserDoc(request.auth.uid) ?
        userDoc(request.auth.uid).data.role :
        null;
    }

    function isOpportunityPublisherRole(role) {
      return role == "recruteur" || role == "club" || role == "agent";
    }

    function isRecruiterOrClub() {
      return signedInAndActive() && isOpportunityPublisherRole(userRole());
    }

    function isSignedInPlayer() {
      return signedInAndActive() && userRole() == "joueur";
    }

    // Gate is the signed custom claim only — the Firestore `role` field is
    // operator-editable (console, script, bad merge) and must never be
    // sufficient on its own to unlock admin-only reads/writes. Mirrors
    // assertAdminCaller() in functions/src/admin_account_support.ts.
    function isAdminOperator() {
      return signedIn() &&
        (
          request.auth.token.admin == true ||
          request.auth.token.platformAdmin == true ||
          request.auth.token.superAdmin == true
        );
    }

    function changesOnly(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    function canUpdateOwnFcmToken() {
      return changesOnly(["fcmToken"]) &&
        request.resource.data.fcmToken is string &&
        request.resource.data.fcmToken.size() > 0 &&
        request.resource.data.fcmToken.size() <= 4096;
    }

    function canUpdateOwnChatPresence() {
      return changesOnly(["activeConversationId", "activeAt"]) &&
        (
          !("activeConversationId" in request.resource.data) ||
          request.resource.data.activeConversationId == null ||
          request.resource.data.activeConversationId is string
        ) &&
        request.resource.data.activeAt == request.time;
    }

    function ownerProfileTrustFieldsChanged() {
      // phone/birthDate live in users/{uid}/private/contact now (see
      // privateContactChangesOnly() below) and are written together with
      // this doc in the same client WriteBatch, so keep them out of this
      // list: it only needs to cover fields still writable directly here.
      // cvUrl stays on this doc on purpose — unlike phone/birthDate it's
      // meant to be visible to third parties whenever profilePublic is
      // true (Storage rules already gate the actual PDF the same way), so
      // it can't move to an owner/admin-only doc without breaking that.
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "nom",
        "languages",
        "bio",
        "position",
        "team",
        "clubActuel",
        "nombreDeMatchs",
        "buts",
        "assistances",
        "performances",
        "nomClub",
        "ligue",
        "entreprise",
        "nombreDeRecrutements",
        "country",
        "city",
        "region",
        "openToOpportunities",
        "playerProfile",
        "clubProfile",
        "agentProfile",
        "eventOrganizerProfile",
        "playerProfile.physical",
        "playerProfile.physical.heightCm",
        "playerProfile.physical.weightKg",
        "playerProfile.physical.strongFoot",
        "playerProfile.positions",
        "playerProfile.skills",
        "playerProfile.licenseNumber",
        "playerProfile.stats",
        "playerProfile.stats.minutes",
        "playerProfile.stats.goals",
        "playerProfile.stats.assists",
        "playerProfile.availability",
        "playerProfile.availability.open",
        "playerProfile.availability.regions",
        "clubProfile.structureType",
        "clubProfile.categories",
        "clubProfile.needs",
        "clubProfile.licenseNumber",
        "agentProfile.licenseNumber",
        "agentProfile.licenseCountry",
        "agentProfile.zones",
        "photoProfil",
        "cvUrl",
      ]);
    }

    function ownerVerificationResetFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "profileVerified",
        "profileVerificationStatus",
        "profileVerificationUpdatedAt",
        "profileVerificationUpdatedBy",
        "profileVerificationInvalidatedAt",
        "profileVerificationInvalidatedBy",
        "profileVerificationInvalidationReason",
      ]);
    }

    function ownerProfileVerificationResetIsValid() {
      return request.resource.data.profileVerified == false &&
        request.resource.data.profileVerificationStatus == "pending" &&
        request.resource.data.profileVerificationUpdatedAt == request.time &&
        request.resource.data.profileVerificationUpdatedBy == request.auth.uid &&
        request.resource.data.profileVerificationInvalidatedAt == request.time &&
        request.resource.data.profileVerificationInvalidatedBy == request.auth.uid &&
        request.resource.data.profileVerificationInvalidationReason == "profile_updated_by_user";
    }

    function ownerProfileVerificationChangesAreSafe() {
      return !ownerVerificationResetFieldsChanged() ||
        ownerProfileVerificationResetIsValid();
    }

    function resourceProfileIsVerified() {
      return ("profileVerified" in resource.data && resource.data.profileVerified == true) ||
        ("profileVerificationStatus" in resource.data && resource.data.profileVerificationStatus == "verified");
    }

    // Used by users/{userId}/private/contact below. That doc can't reuse
    // resourceProfileIsVerified() (resource.data there is the contact doc,
    // not the profile), and can't rely on a same-batch write to the parent
    // doc either: within a batch/transaction, Security Rules evaluate every
    // write against the pre-batch snapshot, so a get() here never observes
    // a sibling write's pending value. The client (profile_repository.dart)
    // accounts for this by committing the parent-doc verification reset as
    // its own awaited write before writing phone/birthDate here whenever
    // the profile is currently verified, so this get() sees the reset.
    function contactOwnerProfileVerified(userId) {
      let profile = get(/databases/$(database)/documents/users/$(userId)).data;
      return ("profileVerified" in profile && profile.profileVerified == true) ||
        ("profileVerificationStatus" in profile && profile.profileVerificationStatus == "verified");
    }

    function verifiedOwnerProfileChangeIsInvalidated() {
      return !resourceProfileIsVerified() ||
        !ownerProfileTrustFieldsChanged() ||
        ownerProfileVerificationResetIsValid();
    }

    function ownerCvUrlChangeIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["cvUrl"]) ||
        (
          userRole() == "joueur" &&
          (
            !("cvUrl" in request.resource.data) ||
            (
              request.resource.data.cvUrl is string &&
              request.resource.data.cvUrl.size() > 0 &&
              request.resource.data.cvUrl.size() <= 2048
            )
          )
        );
    }

    function canUpdateOwnProfile() {
      // phone/birthDate are intentionally absent: they live in
      // users/{uid}/private/contact (rules for that path below). A direct
      // write to this doc that still includes either is rejected by
      // changesOnly() below. cvUrl stays here — see the comment on
      // ownerProfileTrustFieldsChanged() for why.
      return changesOnly([
        "nom",
        "languages",
        "bio",
        "position",
        "team",
        "clubActuel",
        "nombreDeMatchs",
        "buts",
        "assistances",
        "performances",
        "nomClub",
        "ligue",
        "entreprise",
        "nombreDeRecrutements",
        "country",
        "city",
        "region",
        "openToOpportunities",
        "profilePublic",
        "allowMessages",
        "playerProfile",
        "clubProfile",
        "agentProfile",
        "eventOrganizerProfile",
        "playerProfile.physical",
        "playerProfile.physical.heightCm",
        "playerProfile.physical.weightKg",
        "playerProfile.physical.strongFoot",
        "playerProfile.positions",
        "playerProfile.skills",
        "playerProfile.licenseNumber",
        "playerProfile.stats",
        "playerProfile.stats.minutes",
        "playerProfile.stats.goals",
        "playerProfile.stats.assists",
        "playerProfile.availability",
        "playerProfile.availability.open",
        "playerProfile.availability.regions",
        "clubProfile.structureType",
        "clubProfile.categories",
        "clubProfile.needs",
        "clubProfile.licenseNumber",
        "agentProfile.licenseNumber",
        "agentProfile.licenseCountry",
        "agentProfile.zones",
        "photoProfil",
        "cvUrl",
        "profileVerified",
        "profileVerificationStatus",
        "profileVerificationUpdatedAt",
        "profileVerificationUpdatedBy",
        "profileVerificationInvalidatedAt",
        "profileVerificationInvalidatedBy",
        "profileVerificationInvalidationReason",
        "updatedAt",
      ]) &&
      ownerCvUrlChangeIsSafe() &&
      ownerProfileVerificationChangesAreSafe() &&
      verifiedOwnerProfileChangeIsInvalidated();
    }

    function canMutateOfferCandidates() {
      return isSignedInPlayer() &&
        resource.data.recruteur.uid != request.auth.uid &&
        resource.data.statut == "ouverte" &&
        changesOnly(["candidats", "lastUpdated"]);
    }

    function canMutateOfferViews() {
      return signedInAndActive() &&
        resource.data.recruteur.uid != request.auth.uid &&
        changesOnly(["vues", "viewedBy", "lastUpdated"]);
    }

    function canMutateEventParticipants() {
      return isSignedInPlayer() &&
        resource.data.organisateur.uid != request.auth.uid &&
        resource.data.statut == "ouvert" &&
        changesOnly(["participants", "lastUpdated"]);
    }

    function currentVideoLikes() {
      return resource.data.likes is list ? resource.data.likes : [];
    }

    function canAddVideoLike() {
      return !(request.auth.uid in currentVideoLikes()) &&
        request.auth.uid in request.resource.data.likes &&
        request.resource.data.likes.size() == currentVideoLikes().size() + 1 &&
        request.resource.data.likes.hasAll(currentVideoLikes());
    }

    function canRemoveVideoLike() {
      return request.auth.uid in currentVideoLikes() &&
        !(request.auth.uid in request.resource.data.likes) &&
        request.resource.data.likes.size() == currentVideoLikes().size() - 1 &&
        currentVideoLikes().hasAll(request.resource.data.likes);
    }

    function canToggleVideoLike() {
      return signedInAndActive() &&
        changesOnly(["likes"]) &&
        request.resource.data.likes is list &&
        (canAddVideoLike() || canRemoveVideoLike());
    }

    function currentVideoShareCount() {
      return resource.data.shareCount is int ? resource.data.shareCount : 0;
    }

    function canIncrementVideoShareCount() {
      return signedInAndActive() &&
        changesOnly(["shareCount"]) &&
        request.resource.data.shareCount is int &&
        request.resource.data.shareCount == currentVideoShareCount() + 1;
    }

    function currentVideoReports() {
      return resource.data.reports is list ? resource.data.reports : [];
    }

    function currentVideoReportCount() {
      return resource.data.reportCount is int ?
        resource.data.reportCount :
        currentVideoReports().size();
    }

    function canReportVideo() {
      return signedInAndActive() &&
        changesOnly(["reports", "reportCount"]) &&
        request.resource.data.reports is list &&
        request.resource.data.reportCount is int &&
        !(request.auth.uid in currentVideoReports()) &&
        request.auth.uid in request.resource.data.reports &&
        request.resource.data.reports.size() == currentVideoReports().size() + 1 &&
        request.resource.data.reports.hasAll(currentVideoReports()) &&
        request.resource.data.reportCount == currentVideoReportCount() + 1;
    }

    function canReadVideo() {
      return resource.data.status == "ready" ||
        isAdminOperator() ||
        (signedInAndActive() && resource.data.uid == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if signedIn() &&
        (hasActiveAccount(request.auth.uid) || isOwner(userId));
      allow create: if false;
      allow update: if isOwner(userId) &&
        hasActiveAccount(request.auth.uid) &&
        (
          canUpdateOwnFcmToken() ||
          canUpdateOwnChatPresence() ||
          canUpdateOwnProfile()
        );
      allow delete: if isOwner(userId);

      // Sensitive fields (phone/birthDate/email/authDisabledReason) live
      // here instead of on the parent doc so a third party can no longer
      // read them just by having an active account. cvUrl deliberately
      // stays on the parent doc instead (see ownerProfileTrustFieldsChanged
      // comment) — it's meant to be visible to third parties once
      // profilePublic is true, same as the Storage rule already gates the
      // actual PDF. email/authDisabledReason are admin/Cloud-Function
      // managed only (no client "allow write" covers them);
      // phone/birthDate stay owner-editable exactly like before, just
      // relocated. The verification-reset invariant still applies to a
      // phone/birthDate edit on a verified profile — see
      // contactOwnerProfileVerified() below for how, since it can no longer
      // ride along for free in the same WriteBatch as the parent doc.
      match /private/contact {
        allow read: if isOwner(userId) || isAdminOperator();
        allow create: if isOwner(userId) &&
          hasActiveAccount(request.auth.uid) &&
          request.resource.data.keys().hasOnly(["phone", "birthDate"]);
        // Changing phone/birthDate is trust-sensitive exactly like the
        // fields in ownerProfileTrustFieldsChanged() on the parent doc, but
        // this doc can't detect that itself since these values no longer
        // live there. Blocking the change outright while verified — instead
        // of trying to require a same-batch invalidation write, which
        // get() can't observe (see contactOwnerProfileVerified) — forces
        // the client's already-established two-step reset-then-edit flow.
        allow update: if isOwner(userId) &&
          hasActiveAccount(request.auth.uid) &&
          changesOnly(["phone", "birthDate"]) &&
          !contactOwnerProfileVerified(userId);
        allow delete: if isOwner(userId);
      }

      // Internal admin commentary on a profile review — never shown to the
      // user it's about.
      match /private/adminNotes {
        allow read: if isAdminOperator();
      }
    }

    // The two rules above grant `get` on a literal document id (contact,
    // adminNotes) but not `list`: the admin portal's user list enriches
    // rows via a collectionGroup('private') query, and Firestore only
    // authorizes a collection-group `list` against a rule whose last path
    // segment is a wildcard, regardless of what the per-document rules
    // above allow. This rule adds that, admin-only, without loosening the
    // per-document owner/admin semantics already enforced above.
    //
    // That admin query (lib/controller/user_controller.dart, admin repo)
    // currently has no where()/orderBy(), which is the only reason it works
    // without an index. firestore.indexes.json has no COLLECTION_GROUP
    // entry for `private` — add one there before that query (or any other
    // collectionGroup('private') query) gains a filter or sort.
    match /{path=**}/private/{docId} {
      allow list: if isAdminOperator();
    }

    match /videos/{videoId} {
      allow read: if canReadVideo();
      allow create: if false;
      allow update: if canToggleVideoLike();
      allow update: if canIncrementVideoShareCount();
      allow update: if canReportVideo();
      allow delete: if signedInAndActive() &&
        resource.data.uid == request.auth.uid;
    }

    match /offres/{offreId} {
      allow read: if signedInAndActive();
      allow create: if isRecruiterOrClub() &&
        request.resource.data.recruteur.uid == request.auth.uid;
      allow update: if signedInAndActive() &&
        (
          resource.data.recruteur.uid == request.auth.uid ||
          canMutateOfferCandidates() ||
          canMutateOfferViews()
        );
      allow delete: if signedInAndActive() &&
        resource.data.recruteur.uid == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if signedInAndActive();
      allow create: if isRecruiterOrClub() &&
        request.resource.data.organisateur.uid == request.auth.uid;
      allow update: if signedInAndActive() &&
        (
          resource.data.organisateur.uid == request.auth.uid ||
          canMutateEventParticipants()
        );
      allow delete: if signedInAndActive() &&
        resource.data.organisateur.uid == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if signedInAndActive() &&
        request.auth.uid in resource.data.utilisateurIds;
      allow create: if signedInAndActive() &&
        request.auth.uid in request.resource.data.utilisateurIds &&
        request.resource.data.utilisateurIds.size() == 2;
      allow update, delete: if signedInAndActive() &&
        request.auth.uid in resource.data.utilisateurIds;

      match /messages/{messageId} {
        allow read: if signedInAndActive() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.utilisateurIds;
        allow create: if signedInAndActive() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.utilisateurIds &&
          request.resource.data.expediteurId == request.auth.uid;
        allow update, delete: if signedInAndActive() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.utilisateurIds;
      }
    }

    // Created directly by the client (no Cloud Function in front of it), so
    // unlike video_share_limits/log_call_limits this cooldown has to be
    // enforced through the rules themselves: the client must touch its own
    // contact_intake_limits/{uid} doc in the same WriteBatch as the
    // contact_intakes create, and that doc's rule below requires the new
    // timestamp to be strictly after the cooldown window.
    function contactIntakeCooldownOk() {
      let limitPath =
        /databases/$(database)/documents/contact_intake_limits/$(request.auth.uid);
      return !exists(limitPath) ||
        request.time > get(limitPath).data.lastIntakeAt + duration.value(60, "s");
    }

    match /contact_intakes/{intakeId} {
      allow read: if signedInAndActive() &&
        (
          resource.data.requesterUid == request.auth.uid ||
          resource.data.targetUid == request.auth.uid ||
          isAdminOperator()
        );
      allow create: if signedInAndActive() &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.targetUid is string &&
        request.resource.data.targetUid != request.auth.uid &&
        request.resource.data.status == "new" &&
        request.resource.data.agencyFollowUpStatus == "new" &&
        request.resource.data.contactReason is string &&
        request.resource.data.introMessage is string &&
        contactIntakeCooldownOk();
      allow update, delete: if isAdminOperator();
    }

    match /contact_intake_limits/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) &&
        hasActiveAccount(request.auth.uid) &&
        request.resource.data.keys().hasOnly(["lastIntakeAt"]) &&
        request.resource.data.lastIntakeAt == request.time;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Server-only collections
    match /client_logs/{docId} {
      allow read, write: if false;
    }

    match /video_action_logs/{docId} {
      allow read, write: if false;
    }

    match /video_share_limits/{docId} {
      allow read, write: if false;
    }

    match /log_call_limits/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
