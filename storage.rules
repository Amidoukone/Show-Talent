rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function videoDocIdFromFileName(fileName) {
      return fileName[0:fileName.size() - 4];
    }

    function thumbnailDocIdFromJpgFileName(fileName) {
      return fileName[10:fileName.size() - 4];
    }

    function thumbnailDocIdFromJpegFileName(fileName) {
      return fileName[10:fileName.size() - 5];
    }

    function isOwnedVideoDoc(videoId) {
      return firestore.exists(/databases/(default)/documents/videos/$(videoId)) &&
        firestore.get(/databases/(default)/documents/videos/$(videoId)).data.uid == request.auth.uid;
    }

    // Meme forme que isOwnedVideoDoc, et pour la meme raison : le document
    // doit exister avant son fichier. C'est ce qui impose au formulaire de
    // creer l'evenement d'abord et de televerser l'affiche ensuite -- sans
    // quoi il n'y aurait rien contre quoi verifier qui televerse.
    function isOwnedEventDoc(eventId) {
      return firestore.exists(/databases/(default)/documents/events/$(eventId)) &&
        firestore.get(/databases/(default)/documents/events/$(eventId)).data.organisateur.uid == request.auth.uid;
    }

    function hasUserProfileDoc(uid) {
      return firestore.exists(/databases/(default)/documents/users/$(uid));
    }

    function userProfileDoc(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid));
    }

    function hasActiveUserProfile(uid) {
      return hasUserProfileDoc(uid) &&
        userProfileDoc(uid).data.authDisabled != true;
    }

    function isActiveProfileOwner(uid) {
      return signedIn() &&
        request.auth.uid == uid &&
        hasActiveUserProfile(uid);
    }

    function isPlayerProfileOwner(uid) {
      return isActiveProfileOwner(uid) &&
        userProfileDoc(uid).data.role == "joueur";
    }

    // The signed custom claim only, exactly as firestore.rules states the
    // invariant: "the Firestore `role` field is operator-editable (console,
    // script, bad merge) and must never be sufficient on its own to unlock
    // admin-only reads/writes". This file used to accept `role == "admin"` as
    // an equivalent, which is what opened every player's CV to anything that
    // could get that field written. No client write can set `role` today, so
    // nothing was exploitable -- but an invariant asserted in one rules file
    // and contradicted in the other is the kind of gap that outlives the
    // reason it was safe.
    function isAdminOperator() {
      return signedIn() &&
        (
          request.auth.token.admin == true ||
          request.auth.token.platformAdmin == true ||
          request.auth.token.superAdmin == true
        );
    }

    function isOwnedVideoMp4(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]+\\.mp4$') &&
        isOwnedVideoDoc(videoDocIdFromFileName(fileName));
    }

    function isOwnedMp4Rendition(videoId, fileName) {
      return videoId.matches('^[A-Za-z0-9_-]+$') &&
        fileName.matches('^[A-Za-z0-9_.-]+\\.mp4$') &&
        isOwnedVideoDoc(videoId);
    }

    function isOwnedThumbnail(fileName) {
      return (
        fileName.matches('^thumbnail_[A-Za-z0-9_-]+\\.jpg$') &&
        isOwnedVideoDoc(thumbnailDocIdFromJpgFileName(fileName))
      ) || (
        fileName.matches('^thumbnail_[A-Za-z0-9_-]+\\.png$') &&
        isOwnedVideoDoc(thumbnailDocIdFromJpgFileName(fileName))
      ) || (
        fileName.matches('^thumbnail_[A-Za-z0-9_-]+\\.jpeg$') &&
        isOwnedVideoDoc(thumbnailDocIdFromJpegFileName(fileName))
      );
    }

    function isCvFileName(fileName) {
      return fileName.matches('^cv_[0-9]+\\.pdf$');
    }

    function hasDeclaredCvContentType() {
      return request.resource.contentType != null &&
        request.resource.contentType != "";
    }

    function isAllowedCvContentType() {
      return !hasDeclaredCvContentType() ||
        request.resource.contentType.matches('application/pdf(;.*)?') ||
        request.resource.contentType == 'application/x-pdf' ||
        request.resource.contentType == 'application/acrobat' ||
        request.resource.contentType == 'application/vnd.pdf' ||
        request.resource.contentType == 'text/pdf' ||
        request.resource.contentType == 'text/x-pdf' ||
        request.resource.contentType == 'application/octet-stream';
    }

    function isValidCvPdfUpload(fileName) {
      return isCvFileName(fileName) &&
        request.resource.size > 0 &&
        request.resource.size <= 5 * 1024 * 1024 &&
        isAllowedCvContentType();
    }

    function canReadCv(uid) {
      return signedIn() &&
        (
          (request.auth.uid == uid && hasActiveUserProfile(uid)) ||
          isAdminOperator() ||
          (
            hasUserProfileDoc(uid) &&
            userProfileDoc(uid).data.profilePublic == true &&
            userProfileDoc(uid).data.authDisabled != true
          )
        );
    }

    // An avatar is world-readable, so anything written here is served from
    // this project's domain to anyone who asks. The rule used to check only
    // *who* was writing, never *what*: no size ceiling and no content type, on
    // a public path. The CV rule two blocks down has enforced both since it
    // was written -- this one simply never caught up.
    //
    // 8 MB is deliberately generous (the largest avatar in production is
    // 2.0 MB) because the point is not to police photo quality, it is to stop
    // this path being usable as free public file hosting.
    function isValidProfilePhotoUpload() {
      return request.resource.size > 0 &&
        request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('image/.*');
    }

    // Meme plafond que l'avatar, et pour la meme raison : le point n'est pas
    // de juger la qualite d'une affiche, il est d'empecher ce chemin de servir
    // d'hebergement de fichiers gratuit.
    function isValidEventFlyerUpload() {
      return request.resource.size > 0 &&
        request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('image/.*');
    }

    match /profilePhotos/{uid} {
      allow read: if true;
      allow create, update: if isActiveProfileOwner(uid) &&
        isValidProfilePhotoUpload();
      allow delete: if isActiveProfileOwner(uid);
    }

    match /cvs/{uid}/{fileName} {
      allow read: if canReadCv(uid);
      allow create, update: if isPlayerProfileOwner(uid) &&
        isValidCvPdfUpload(fileName);
      allow delete: if isActiveProfileOwner(uid);
    }

    // Lecture reservee aux comptes connectes, contrairement aux avatars et aux
    // vignettes. Un evenement n'est lisible que par `signedInAndActive()` dans
    // firestore.rules ; servir son affiche au monde entier serait plus large
    // que la donnee qu'elle illustre, et un evenement peut etre prive.
    match /eventFlyers/{eventId} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
        isOwnedEventDoc(eventId) &&
        isValidEventFlyerUpload();
      allow delete: if signedIn() && isOwnedEventDoc(eventId);
    }

    match /videos/{videoFileName} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if signedIn() && isOwnedVideoMp4(videoFileName);
    }

    match /mp4/{videoId}/{fileName} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if signedIn() && isOwnedMp4Rendition(videoId, fileName);
    }

    match /thumbnails/{fileName} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if signedIn() && isOwnedThumbnail(fileName);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
